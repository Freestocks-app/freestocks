    "@solana/web3.js": "^1.99.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "^1.7.3",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
