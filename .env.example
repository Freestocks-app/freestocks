# =============================================================================
# Freestocks Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for local development.
# Never commit secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Use POSTGRES_URL for Neon/Vercel Postgres, or DATABASE_URL as fallback.
# If neither is set, a local PGlite database is used (SQLite-compatible).
POSTGRES_URL=
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication (better-auth)
# -----------------------------------------------------------------------------
# Required: Generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Required: Base URL for auth callbacks (e.g., http://localhost:3847)
BETTER_AUTH_URL=http://localhost:3847

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional) - either provide CLIENT_SECRET directly or JWT config
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Or for JWT-based auth:
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Required for email/password sign-up: sends the verification email.
# Get a key from https://resend.com (API Keys tab) - the sending domain
# (freestocks.app) must be verified there first (Domains tab -> add DNS
# records). Without this set, verification emails silently fail to send
# (logged, not thrown) and users can never complete email/password sign-up.
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# BitLabs Integration
# -----------------------------------------------------------------------------
# App token for iframe URL (from BitLabs dashboard)
BITLABS_TOKEN=

# App secret for HMAC verification (from BitLabs dashboard)
BITLABS_SECRET=

# -----------------------------------------------------------------------------
# Ayet Integration
# -----------------------------------------------------------------------------
AYET_API_KEY=
AYET_ADSLOT_ID=

# -----------------------------------------------------------------------------
# Unlock Rail Configuration
# -----------------------------------------------------------------------------
# Set to 'solana' for Solana wallet unlock (stocklana branch)
# Leave unset or 'fomo' for FOMO/RH Chain unlock (main branch)
NEXT_PUBLIC_UNLOCK_RAIL=solana

# -----------------------------------------------------------------------------
# Privy (for Solana wallet unlock)
# -----------------------------------------------------------------------------
# Privy App ID for email OTP + embedded Solana wallet
# 
# Setup in Privy Dashboard (https://dashboard.privy.io):
# 1. Create a new app or use existing
# 2. Go to "Login Methods" → Enable "Email" (with OTP)
# 3. Go to "Embedded Wallets" → Enable "Solana" → Set "Create on login" to "All users"
# 4. Go to "Settings" → Copy your App ID
# 5. Add your domain to "Allowed Origins" (localhost:3847 for dev, your prod domain)
#
# The App ID is public (NEXT_PUBLIC_*) - it identifies your app but doesn't grant access.
# No server-side Privy secret is needed for this email OTP + embedded wallet flow.
NEXT_PUBLIC_PRIVY_APP_ID=

# -----------------------------------------------------------------------------
# Pyth Price Feeds (optional)
# -----------------------------------------------------------------------------
# Primary price source for public equities on the LP ticker and /api/prices.
# Without a key, the app falls back to DexScreener automatically - no crash,
# no blank prices.
#
# Get a key from the Pyth Pro dashboard (https://pyth.network), then use it
# as a Bearer token against Hermes: https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# -----------------------------------------------------------------------------
# Solana RPC (optional)
# -----------------------------------------------------------------------------
# Used client-side to read wallet SOL/token balances (My Wallet tab, profile
# page) and to build/send Trade and Send transactions. Defaults to the public
# mainnet-beta RPC if unset - swap in a paid provider (Helius, Alchemy, etc.)
# here if the public endpoint gets rate-limited. If using Alchemy, make sure
# every domain the app is served from is added to that key's Origin allowlist
# in the Alchemy dashboard, or requests from unlisted hosts will be silently
# CORS-blocked in the browser.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# -----------------------------------------------------------------------------
# Jupiter Swap API (optional)
# -----------------------------------------------------------------------------
# Used by Trade to get swap quotes and build swap transactions
# (https://api.jup.ag/swap/v1). Works with no key (free tier, low rate
# limit) - add one from https://portal.jup.ag if Trade starts hitting
# 429s under real usage.
NEXT_PUBLIC_JUPITER_API_KEY=

# -----------------------------------------------------------------------------
# Coming Soon gate (optional)
# -----------------------------------------------------------------------------
# When 'true', gates the public app behind a "Coming Soon" landing state.
# Bypassed by the QA path in middleware.ts, which sets a cookie. Leave unset
# to keep the full app open.
NEXT_PUBLIC_COMING_SOON=

# -----------------------------------------------------------------------------
# Legacy: Fomo Referral (main branch only)
# -----------------------------------------------------------------------------
# Referral URL for the Fomo integration (defaults to placeholder if not set)
# Not used when NEXT_PUBLIC_UNLOCK_RAIL=solana
FOMO_REFERRAL_URL=https://fomo.family/r/freestocks

# -----------------------------------------------------------------------------
# Base mainnet RPC (optional, ETHGlobal Uniswap track)
# -----------------------------------------------------------------------------
# Used by the Trade screen's Ethereum tab (Uniswap v3 swaps against
# Coinbase's tokenized stocks on Base). Defaults to the public Base RPC if
# unset - swap in a paid provider (Alchemy, etc.) if it gets rate-limited.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# World ID (ETHGlobal IDKit track)
# -----------------------------------------------------------------------------
# Register an app + RP at the Worldcoin Developer Portal
# (https://developer.world.org) to get these. WORLD_ID_SIGNING_KEY is a
# server secret - it's what proves verification requests actually came
# from this app's backend, so it must NEVER be exposed client-side or
# committed. Without these set, the "Verify with World ID" card on the
# profile page is hidden entirely (no broken UI, no crash).
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ACTION=verify-human
